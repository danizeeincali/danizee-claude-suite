{
  "tolerance": {
    "high": 0,
    "medium": 2,
    "low": 5,
    "passes_in_a_row": 2
  },
  "lines": [
    {
      "id": "e2e_streak",
      "label": "Green /w-bbs end-to-end runs in a row (usage -> targets -> verdict -> handoff with an integration stream)",
      "type": "number",
      "op": "at_least",
      "value": 2,
      "owner": "build",
      "source": "runs.streak:e2e",
      "scope": "run"
    },
    {
      "id": "unit_streak",
      "label": "Green unit runs in a row",
      "type": "number",
      "op": "at_least",
      "value": 1,
      "owner": "build",
      "source": "runs.streak:unit",
      "scope": "stream"
    },
    {
      "id": "clean_reviews",
      "label": "Clean reviews in a row",
      "type": "number",
      "op": "at_least",
      "value": 2,
      "owner": "build",
      "source": "reviews.streak",
      "scope": "stream"
    },
    {
      "id": "latest_high",
      "label": "High findings in the latest review",
      "type": "number",
      "op": "at_most",
      "value": 0,
      "owner": "build",
      "source": "reviews.latest.high",
      "scope": "stream"
    },
    {
      "id": "open_high",
      "label": "Open high findings",
      "type": "number",
      "op": "at_most",
      "value": 0,
      "owner": "build",
      "source": "findings.open:high",
      "scope": "stream"
    },
    {
      "id": "helpers_over_budget",
      "label": "Helpers that blew their budget",
      "type": "number",
      "op": "at_most",
      "value": 2,
      "owner": "build",
      "source": "helpers.over_budget",
      "scope": "run"
    },
    {
      "id": "full_suite",
      "label": "Full npm test green after the last stream",
      "type": "bool",
      "op": "is",
      "value": true,
      "owner": "build",
      "source": "measure:full_suite",
      "scope": "run"
    },
    {
      "id": "replay_catches_openqodex",
      "label": "The new wired measure reports redact as not wired on current main for the OpenQodex powers",
      "type": "bool",
      "op": "is",
      "value": true,
      "owner": "build",
      "source": "measure:replay_catches_openqodex",
      "scope": "run"
    },
    {
      "id": "regenerated",
      "label": "Installed copies (.claude/commands/.shortcuts, .claude/helpers/bbs) equal their sources",
      "type": "bool",
      "op": "is",
      "value": true,
      "owner": "build",
      "source": "measure:regenerated",
      "scope": "run"
    }
  ]
}