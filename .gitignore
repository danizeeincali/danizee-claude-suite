# Dependencies
node_modules

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build
dist/
build/

# Test
coverage/

# Cache
.cache/
.npm/

# Marathon wake-up logs
.claude/marathon/*/wake.log

# RuFlo / RuVector MCP local state (task db, memory, embeddings)
.swarm/
.claude-flow/
ruvector.db

# Marathon: machine-local pointer to the active run
.claude/marathon/ACTIVE

# BBS: fetched/ holds foreign source and is never committed; the rest is machine-local state (active-run pointer, lock, temp files)
.claude/bbs/ACTIVE
.claude/bbs/runs/*/fetched/
.claude/bbs/runs/*/map.lock
.claude/bbs/runs/*/*.tmp

# Kit: the redact verb's list of secret values is machine-local and never committed
.claude/kit/secrets
.claude/kit/cache/
